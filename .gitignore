# ── Secrets ───────────────────────────────────────────────────────────────────
# Every real key lives in .env. Only .env.example is tracked.
.env
.env.*
!.env.example
*.pem
*.key

# ── Personal data ─────────────────────────────────────────────────────────────
# Real resumes: someone's actual name, phone and address history. The evals do NOT
# need them — the parses are snapshotted into evals/golden/ with contact details
# redacted (see agentception/evals/pii.py), so CI runs the full suite without them.
resume/

# ── Personal study material ───────────────────────────────────────────────────
# The 17-chapter HTML book (interview prep, role framing, resume bullets). It's a
# personal learning artefact, not part of the product, and it's read straight off
# disk — open "html explainer files/index.html". Deliberately untracked.
html explainer files/

# ── Not part of this project ──────────────────────────────────────────────────
# A separate Flask app. Its curated study data was copied into
# agentception/server/data/study/; the app itself isn't shipped here.
learning-path-generator/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# ── Databases (runtime state, rebuilt on boot) ────────────────────────────────
# agentception.db was tracked until now, carrying 328 KB of stale rows from an
# earlier version of this project. Seed data under data/seeds/ stays tracked.
*.db
*.db-journal
*.sqlite3

# ── Node / frontend ───────────────────────────────────────────────────────────
node_modules/
dist/
.vite/
*.tsbuildinfo

# ── Local tooling & scratch ───────────────────────────────────────────────────
.claude/
.cursor/
.playwright-mcp/
*.log
.DS_Store
Thumbs.db
