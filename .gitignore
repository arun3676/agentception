# Secrets
# Every real key lives in .env. Only .env.example is tracked.
.env
.env.*
!.env.example
*.pem
*.key

# Personal data
# Never commit user resumes. Offline evals use the visibly synthetic source in
# agentception/evals/fixtures/synthetic_resume.json.
resume/

# Browser output can contain uploaded document text and authenticated page state.
agentception/e2e/screenshots/
agentception/e2e/**/*.png
agentception/e2e/**/*.webm
agentception/e2e/**/*.zip
agentception/e2e/fixtures/*.pdf
agentception/test-results/
agentception/playwright-report/
agentception/blob-report/

# Personal study material
html explainer files/

# Not part of this project
learning-path-generator/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Databases (runtime state, rebuilt on boot)
*.db
*.db-journal
*.sqlite3

# Node / frontend
node_modules/
dist/
.vite/
*.tsbuildinfo

