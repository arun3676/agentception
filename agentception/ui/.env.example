# Copy to .env.local and fill in secrets (never commit .env.local).

# Backend URL — change for production (e.g. https://agentception1809.up.railway.app)
VITE_BACKEND_URL=http://localhost:8000

# Supabase project (Vite client — use VITE_*)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Legacy anon JWT (API → Legacy anon key) — Edge Function calls use Bearer with this value
VITE_SUPABASE_ANON_KEY=
# Optional: new publishable key (sb_publishable_…)
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional: create a user under Authentication → Users, then paste UUID here
VITE_SUPABASE_DEFAULT_USER_ID=

# Server-only (Edge scripts / backend) — never expose with VITE_
SUPABASE_SECRET_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Backend CORS — set to your deployed frontend URL for production
# FRONTEND_ORIGIN=https://your-frontend.vercel.app
