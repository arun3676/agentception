# Runtime
APP_ENV=development
FRONTEND_ORIGINS=http://localhost:8080

# Public discovery providers. Production refuses startup when either is absent.
TAVILY_API_KEY=
EXA_API_KEY=
EXA_MAX_CONCURRENCY=2
TAVILY_MAX_CONCURRENCY=2

# Optional ranking provider. Missing capability must remain explicit in product behavior.
VOYAGE_API_KEY=

# Supabase JWT issuer for authenticated maintenance/private API calls.
# The containment UI does not expose sign-in or send a browser Supabase key.
SUPABASE_URL=

# Server-only credentials reserved for later reviewed private workflows.
# The containment browser does not use them. Never expose them through VITE_*.
SUPABASE_SERVICE_ROLE_KEY=
REDUCTO_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Planned Postgres and provider-budget controls. The containment runtime does not
# consume or enforce these yet; merely setting them does not make it release-ready.
DATABASE_URL=
MIGRATION_DATABASE_URL=
PROVIDER_DAILY_BUDGET_USD=

# Local/test SQLite path. Production persistence is not durable until the Postgres
# workflow migration lands; do not treat this as a production database setting.
AGENTCEPTION_DB=./data/agentception.db

# Unsafe development switches. Production startup rejects true values.
MOCK_SEARCH=false
RATE_LIMIT_DISABLED=false
TAVILY_DISABLE_SSL_VERIFY=false
DEBUG_DISCOVERY=false
