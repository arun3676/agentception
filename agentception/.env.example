# Frontend
FRONTEND_ORIGIN=http://localhost:8080

# Search providers
TAVILY_API_KEY=
EXA_API_KEY=
APIFY_TOKEN=
MOCK_SEARCH=false
# Parallel Exa calls. 1 serializes the study search's two queries.
EXA_MAX_CONCURRENCY=2

# Document parsing (resume) — https://platform.reducto.ai
REDUCTO_API_KEY=

# LLM providers
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
VOYAGE_API_KEY=
PERPLEXITY_API_KEY=
AGENTCEPTION_CHAT_MODEL=deepseek-chat
AGENTCEPTION_OPENAI_FALLBACK_MODEL=gpt-4o-mini
AGENTCEPTION_EMBEDDING_MODEL=voyage-3-lite

# External APIs
GOOGLE_MAPS_KEY=

# Persistence
DATABASE_URL=sqlite:///./data/agentception.db
REDIS_URL=
# Bounded LRU for uploaded resumes held in memory
MAX_CACHED_RESUMES=200

# Sibling repo supplying curated learning-path data (defaults to ../learning-path-generator)
LEARNING_PATH_DATA=

# Supabase — auth (JWKS), readiness tables, /health.
# Fresh project setup: run migrations/003_supabase_project_setup.sql in the SQL editor.
# SERVICE_ROLE accepts either the legacy service_role JWT or the newer sb_secret_...
# key (verified against PostgREST + supabase-py). Server-side only — never VITE_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Browser-side (Vite inlines these at BUILD time — changing them requires a rebuild).
# The anon/publishable key is safe to expose; RLS is what protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_DEFAULT_USER_ID=
